{
  "name": "Exam",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "عنوان الامتحان"
    },
    "topic_id": {
      "type": "string",
      "description": "معرف الموضوع المرتبط"
    },
    "topic_title": {
      "type": "string",
      "description": "عنوان الموضوع"
    },
    "section_title": {
      "type": "string",
      "description": "عنوان القسم"
    },
    "school_id": {
      "type": "string",
      "description": "معرف المدرسة — general للامتحانات العامة المشتركة بين المدارس"
    },
    "questions": {
      "type": "array",
      "description": "قائمة الأسئلة",
      "items": {
        "type": "object",
        "properties": {
          "text": { "type": "string" },
          "type": { "type": "string", "enum": ["mcq", "short", "truefalse"] },
          "options": { "type": "array", "items": { "type": "string" } },
          "answer": { "type": "string" }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published"],
      "default": "draft"
    },
    "duration_minutes": {
      "type": "number",
      "description": "مدة الامتحان بالدقائق"
    }
  },
  "required": ["title"],
  "rls": {
    "read": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "$and": [ { "user_condition": { "role": "school_admin" } }, { "$or": [ { "data.school_id": "{{user.data.school_id}}" }, { "data.school_id": "general" } ] } ] },
        { "$and": [ { "user_condition": { "role": "student" } }, { "$or": [ { "data.school_id": "{{user.data.school_id}}" }, { "data.school_id": "general" }, { "data.school_id": { "$exists": false } } ] } ] }
      ]
    },
    "create": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "$and": [ { "user_condition": { "role": "school_admin" } }, { "data.school_id": "{{user.data.school_id}}" } ] }
      ]
    },
    "update": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "$and": [ { "user_condition": { "role": "school_admin" } }, { "data.school_id": "{{user.data.school_id}}" } ] }
      ]
    },
    "delete": {
      "$or": [
        { "user_condition": { "role": "admin" } },
        { "$and": [ { "user_condition": { "role": "school_admin" } }, { "data.school_id": "{{user.data.school_id}}" } ] }
      ]
    }
  }
}