{
  "name": "Exam",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "عنوان الامتحان"
    },
    "topic_id": {
      "type": "string",
      "description": "معرف الموضوع المرتبط"
    },
    "topic_title": {
      "type": "string",
      "description": "عنوان الموضوع"
    },
    "section_title": {
      "type": "string",
      "description": "عنوان القسم"
    },
    "questions": {
      "type": "array",
      "description": "قائمة الأسئلة",
      "items": {
        "type": "object",
        "properties": {
          "text": { "type": "string" },
          "type": { "type": "string", "enum": ["mcq", "short", "truefalse"] },
          "options": { "type": "array", "items": { "type": "string" } },
          "answer": { "type": "string" }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["draft", "published"],
      "default": "draft"
    },
    "duration_minutes": {
      "type": "number",
      "description": "مدة الامتحان بالدقائق"
    }
  },
  "required": ["title"]
}