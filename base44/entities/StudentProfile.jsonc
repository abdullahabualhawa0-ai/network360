{
  "name": "StudentProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645"
    },
    "full_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "school_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u062f\u0631\u0633\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "disabled"
      ],
      "default": "pending",
      "description": "\u062d\u0627\u0644\u0629 \u062d\u0633\u0627\u0628 \u0627\u0644\u0637\u0627\u0644\u0628"
    },
    "approved_by": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u0633\u0624\u0648\u0644 \u0627\u0644\u0630\u064a \u0648\u0627\u0641\u0642"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "ar",
        "en",
        "he"
      ],
      "default": "ar"
    }
  },
  "required": [
    "user_id",
    "email",
    "school_id"
  ]
}