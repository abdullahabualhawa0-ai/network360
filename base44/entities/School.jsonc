{
  "name": "School",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u062f\u0631\u0633\u0629"
    },
    "code": {
      "type": "string",
      "description": "\u0631\u0645\u0632 \u0627\u0644\u0645\u062f\u0631\u0633\u0629 \u0627\u0644\u0641\u0631\u064a\u062f (School Code) \u2014 \u0645\u062b\u0644 SCH2026A\u060c \u0644\u0627 \u064a\u0645\u0643\u0646 \u062a\u0643\u0631\u0627\u0631\u0647"
    },
    "admin_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0645\u0633\u0624\u0648\u0644 \u0627\u0644\u0631\u0626\u064a\u0633\u064a (\u0627\u062e\u062a\u064a\u0627\u0631\u064a \u2014 \u0627\u0644\u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u0623\u0633\u0627\u0633\u064a\u0629 \u0644\u062a\u0639\u064a\u064a\u0646 \u0645\u0634\u0631\u0641 \u0627\u0644\u0645\u062f\u0631\u0633\u0629 \u0647\u064a \u0632\u0631 \u062a\u0639\u064a\u064a\u0646 \u0645\u0634\u0631\u0641)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u062f\u0631\u0633\u0629 \u2014 false \u062a\u0639\u0646\u064a \u0645\u0639\u0637\u0644\u0629 \u0648\u0644\u0627 \u062a\u064f\u0642\u0628\u0644 \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0628\u0631\u0645\u0632\u0647\u0627"
    },
    "created_by_id": {
      "type": "string",
      "description": "\u0645\u0646 \u0623\u0646\u0634\u0623 \u0627\u0644\u0645\u062f\u0631\u0633\u0629"
    },
    "subscription_plan": {
      "type": "string",
      "enum": [
        "personal_monthly",
        "personal_annual",
        "school_50",
        "school_100",
        "school_200",
        "school_max"
      ],
      "default": "school_50",
      "description": "\u062e\u0637\u0629 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643 \u2014 \u0634\u062e\u0635\u064a\u0629 (\u0634\u0647\u0631\u064a/\u0633\u0646\u0648\u064a) \u0623\u0648 \u0645\u062f\u0631\u0633\u064a\u0629 \u062d\u0633\u0628 \u0639\u062f\u062f \u0627\u0644\u0637\u0644\u0627\u0628"
    },
    "student_limit": {
      "type": "number",
      "default": 50,
      "description": "\u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0639\u062f\u062f \u0627\u0644\u0637\u0644\u0627\u0628 \u0627\u0644\u0645\u0633\u0645\u0648\u062d \u0628\u0647 \u0641\u064a \u0627\u0644\u062e\u0637\u0629 \u0627\u0644\u062d\u0627\u0644\u064a\u0629"
    },
    "current_student_count": {
      "type": "number",
      "default": 0,
      "description": "\u0639\u062f\u062f \u0627\u0644\u0637\u0644\u0627\u0628 \u0627\u0644\u062d\u0627\u0644\u064a\u064a\u0646 \u0641\u064a \u0627\u0644\u0645\u062f\u0631\u0633\u0629 (\u062a\u064f\u0632\u0627\u0645\u0646 \u0639\u0646\u062f \u0643\u0644 \u0625\u0636\u0627\u0641\u0629 \u0639\u0628\u0631 \u062f\u0627\u0644\u0629 \u0627\u0644\u062e\u0627\u062f\u0645)"
    },
    "teacher_limit": {
      "type": "number",
      "default": 0,
      "description": "\u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0639\u062f\u062f \u0627\u0644\u0623\u0633\u0627\u062a\u0630\u0629 \u0627\u0644\u0645\u0633\u0645\u0648\u062d \u0628\u0647 \u2014 \u064a\u064f\u0636\u0628\u0637 \u0645\u0646 \u0637\u0644\u0628 \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0645\u062f\u0631\u0633\u064a"
    },
    "subscription_status": {
      "type": "string",
      "enum": [
        "pending",
        "active",
        "expired"
      ],
      "default": "pending",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643 \u2014 pending=\u0628\u0627\u0646\u062a\u0638\u0627\u0631 \u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u0645\u0627\u0644\u0643\u060c active=\u0641\u0639\u0651\u0627\u0644\u060c expired=\u0645\u0646\u062a\u0647\u064a"
    },
    "admin_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0645\u0633\u0624\u0648\u0644 \u0627\u0644\u0645\u062f\u0631\u0633\u0629 \u2014 \u0645\u0646 \u0627\u0633\u062a\u0628\u064a\u0627\u0646 \u0627\u0644\u062a\u0633\u062c\u064a\u0644"
    },
    "contact_phone": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0647\u0627\u062a\u0641 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u2014 \u0645\u0646 \u0627\u0633\u062a\u0628\u064a\u0627\u0646 \u0627\u0644\u062a\u0633\u062c\u064a\u0644"
    },
    "country": {
      "type": "string",
      "description": "\u0627\u0644\u062f\u0648\u0644\u0629 / \u0627\u0644\u0628\u0644\u062f \u2014 \u0645\u0646 \u0627\u0633\u062a\u0628\u064a\u0627\u0646 \u0627\u0644\u062a\u0633\u062c\u064a\u0644"
    },
    "expected_students": {
      "type": "number",
      "description": "\u0639\u062f\u062f \u0627\u0644\u0637\u0644\u0627\u0628 \u0627\u0644\u0645\u062a\u0648\u0642\u0639 \u2014 \u0645\u0646 \u0627\u0633\u062a\u0628\u064a\u0627\u0646 \u0627\u0644\u062a\u0633\u062c\u064a\u0644"
    }
  },
  "required": [
    "name",
    "code"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}