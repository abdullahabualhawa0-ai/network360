{
  "name": "ExamResult",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "student_email": {
      "type": "string"
    },
    "school_id": {
      "type": "string"
    },
    "exam_id": {
      "type": "string"
    },
    "exam_title": {
      "type": "string"
    },
    "score": {
      "type": "number"
    },
    "percentage": {
      "type": "number"
    },
    "total_questions": {
      "type": "number"
    },
    "correct_answers": {
      "type": "number"
    },
    "wrong_answers": {
      "type": "number"
    },
    "answers": {
      "type": "object",
      "description": "\u0625\u062c\u0627\u0628\u0627\u062a \u0627\u0644\u0637\u0627\u0644\u0628"
    },
    "start_time": {
      "type": "string",
      "format": "date-time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time"
    },
    "submission_time": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "in_progress",
        "submitted",
        "graded"
      ],
      "default": "submitted"
    },
    "allow_retake": {
      "type": "boolean",
      "default": false,
      "description": "\u0647\u0644 \u0633\u0645\u062d \u0627\u0644\u0623\u0633\u062a\u0627\u0630 \u0628\u0625\u0639\u0627\u062f\u0629 \u062a\u0642\u062f\u064a\u0645 \u0627\u0644\u0627\u0645\u062a\u062d\u0627\u0646 \u0644\u0644\u0637\u0627\u0644\u0628"
    },
    "retake_allowed_at": {
      "type": "string",
      "format": "date-time"
    },
    "retake_allowed_by": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0623\u0648 \u0631\u0645\u0632 \u0627\u0644\u0623\u0633\u062a\u0627\u0630 \u0627\u0644\u0630\u064a \u0633\u0645\u062d \u0628\u0627\u0644\u0625\u0639\u0627\u062f\u0629"
    }
  },
  "required": [
    "student_id",
    "exam_id",
    "school_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "school_admin"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "school_admin"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "school_admin"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "school_admin"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}"
            }
          ]
        }
      ]
    }
  }
}