{
  "name": "Teacher",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0623\u0633\u062a\u0627\u0630"
    },
    "teacher_code": {
      "type": "string",
      "description": "\u0631\u0645\u0632 \u0627\u0644\u0623\u0633\u062a\u0627\u0630 \u2014 \u0641\u0631\u064a\u062f \u062f\u0627\u062e\u0644 \u0627\u0644\u0645\u062f\u0631\u0633\u0629 (\u0645\u062b\u0644 TCH-1025)"
    },
    "email": {
      "type": "string",
      "description": "\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a (\u0627\u062e\u062a\u064a\u0627\u0631\u064a)"
    },
    "phone": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0627\u0644\u0647\u0627\u062a\u0641 (\u0627\u062e\u062a\u064a\u0627\u0631\u064a)"
    },
    "subject": {
      "type": "string",
      "description": "\u0627\u0644\u0645\u0627\u062f\u0629 \u0627\u0644\u062a\u064a \u064a\u062f\u0631\u0633\u0647\u0627 (\u0645\u062b\u0644: \u0634\u0628\u0643\u0627\u062a\u060c \u0628\u0631\u0645\u062c\u0629\u060c \u0631\u064a\u0627\u0636\u064a\u0627\u062a)"
    },
    "school_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0651\u0641 \u0627\u0644\u0645\u062f\u0631\u0633\u0629 \u0627\u0644\u062a\u0627\u0628\u0639 \u0644\u0647\u0627 \u0627\u0644\u0623\u0633\u062a\u0627\u0630"
    },
    "school_code": {
      "type": "string",
      "description": "\u0631\u0645\u0632 \u0627\u0644\u0645\u062f\u0631\u0633\u0629 \u0627\u0644\u062a\u0627\u0628\u0639 \u0644\u0647\u0627 \u0627\u0644\u0623\u0633\u062a\u0627\u0630 \u2014 \u0644\u0644\u062a\u062d\u0642\u0642 \u0627\u0644\u0633\u0631\u064a\u0639 \u0639\u0646\u062f \u0627\u0644\u062f\u062e\u0648\u0644"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "disabled"
      ],
      "default": "active",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0623\u0633\u062a\u0627\u0630 \u2014 active=\u0645\u0641\u0639\u0651\u0644\u060c disabled=\u0645\u0639\u0637\u0651\u0644"
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "ar",
        "en",
        "he"
      ],
      "default": "ar"
    }
  },
  "required": [
    "full_name",
    "teacher_code",
    "school_id",
    "school_code"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "school_admin"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "school_admin"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "school_admin"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "school_admin"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}"
            }
          ]
        }
      ]
    }
  }
}