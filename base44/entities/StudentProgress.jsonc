{
  "name": "StudentProgress",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0645\u0644\u0641 \u0627\u0644\u0637\u0627\u0644\u0628 (StudentProfile.id) \u2014 \u064a\u064f\u0633\u062a\u062e\u062f\u0645 \u0644\u0639\u0632\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0641\u064a \u0646\u0638\u0627\u0645 \u0627\u0644\u062c\u0644\u0633\u0627\u062a"
    },
    "student_email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0627\u0644\u0637\u0627\u0644\u0628"
    },
    "student_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0637\u0627\u0644\u0628"
    },
    "topic_progress": {
      "type": "object",
      "description": "\u0645\u0648\u0627\u0636\u064a\u0639 \u062a\u0645\u062a \u0632\u064a\u0627\u0631\u062a\u0647\u0627 - key: topicId, value: {visited, visitedAt}"
    },
    "quiz_results": {
      "type": "object",
      "description": "\u0646\u062a\u0627\u0626\u062c \u0627\u0644\u0627\u062e\u062a\u0628\u0627\u0631\u0627\u062a - key: quizId, value: {score, completedAt}"
    },
    "total_topics_visited": {
      "type": "number",
      "description": "\u0639\u062f\u062f \u0627\u0644\u0645\u0648\u0627\u0636\u064a\u0639 \u0627\u0644\u062a\u064a \u062a\u0645\u062a \u0632\u064a\u0627\u0631\u062a\u0647\u0627"
    },
    "total_quizzes_completed": {
      "type": "number",
      "description": "\u0639\u062f\u062f \u0627\u0644\u0627\u062e\u062a\u0628\u0627\u0631\u0627\u062a \u0627\u0644\u0645\u0643\u062a\u0645\u0644\u0629"
    },
    "avg_quiz_score": {
      "type": "number",
      "description": "\u0645\u062a\u0648\u0633\u0637 \u062f\u0631\u062c\u0627\u062a \u0627\u0644\u0627\u062e\u062a\u0628\u0627\u0631\u0627\u062a"
    },
    "last_synced_at": {
      "type": "string",
      "format": "date-time",
      "description": "\u0622\u062e\u0631 \u0648\u0642\u062a \u062a\u0632\u0627\u0645\u0646"
    }
  },
  "required": [
    "student_email"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}