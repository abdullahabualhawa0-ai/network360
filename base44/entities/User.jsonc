{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "school_admin",
        "student"
      ],
      "default": "student",
      "description": "\u062f\u0648\u0631 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645: admin=\u0645\u062f\u064a\u0631 \u0639\u0627\u0645 (Super Admin)\u060c school_admin=\u0645\u0634\u0631\u0641 \u0645\u062f\u0631\u0633\u0629\u060c student=\u0637\u0627\u0644\u0628"
    },
    "school_id": {
      "type": "string",
      "description": "\u0645\u0639\u0631\u0641 \u0627\u0644\u0645\u062f\u0631\u0633\u0629 \u0627\u0644\u062a\u064a \u064a\u062a\u0628\u0639 \u0644\u0647\u0627 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u2014 \u064a\u064f\u0633\u062a\u062e\u062f\u0645 \u0644\u0639\u0632\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0628\u064a\u0646 \u0627\u0644\u0645\u062f\u0627\u0631\u0633 \u0639\u0644\u0649 \u0645\u0633\u062a\u0648\u0649 \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "school",
        "personal"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u062d\u0633\u0627\u0628: school=\u0645\u0633\u062a\u062e\u062f\u0645 \u062a\u0627\u0628\u0639 \u0644\u0645\u062f\u0631\u0633\u0629 (\u062f\u062e\u0648\u0644 \u0628\u0631\u0645\u0648\u0632 \u0627\u0644\u0645\u062f\u0631\u0633\u0629 \u0648\u0627\u0644\u0637\u0627\u0644\u0628)\u060c personal=\u0645\u0633\u062a\u062e\u062f\u0645 \u0645\u0633\u062a\u0642\u0644 \u0628\u062f\u0648\u0646 \u0645\u062f\u0631\u0633\u0629 (\u062e\u0637\u0629 \u0634\u062e\u0635\u064a\u0629 \u0628\u062f\u0648\u0646 School Code)"
    }
  },
  "required": []
}