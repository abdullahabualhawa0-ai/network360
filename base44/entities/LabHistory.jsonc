{
  "name": "LabHistory",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string"
    },
    "school_id": {
      "type": "string"
    },
    "scenario_id": {
      "type": "string"
    },
    "scenario_title": {
      "type": "string"
    },
    "scenario_difficulty": {
      "type": "string"
    },
    "scenario_xp": {
      "type": "number",
      "description": "\u0642\u064a\u0645\u0629 XP \u0627\u0644\u0645\u062a\u0648\u0642\u0639\u0629 \u0644\u0644\u0633\u064a\u0646\u0627\u0631\u064a\u0648 (\u062a\u064f\u0645\u0646\u062d \u0645\u0646 \u0627\u0644\u062e\u0627\u062f\u0645 \u0641\u0642\u0637 \u0639\u0646\u062f \u0625\u0646\u062c\u0627\u0632 \u0643\u0644 \u0627\u0644\u0645\u0647\u0627\u0645)"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "partially_completed",
        "completed"
      ],
      "default": "in_progress"
    },
    "tasks_total": {
      "type": "number",
      "default": 0
    },
    "tasks_completed": {
      "type": "number",
      "default": 0
    },
    "score": {
      "type": "number",
      "default": 0
    },
    "xp_earned": {
      "type": "number",
      "default": 0
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_activity_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "student_id",
    "scenario_id",
    "school_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "school_admin"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "school_admin"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "school_admin"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "school_admin"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}"
            }
          ]
        }
      ]
    }
  }
}