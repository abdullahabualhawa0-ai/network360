{
  "name": "LabHistory",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string"
    },
    "school_id": {
      "type": "string"
    },
    "scenario_id": {
      "type": "string"
    },
    "scenario_title": {
      "type": "string"
    },
    "scenario_difficulty": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "partially_completed",
        "completed"
      ],
      "default": "in_progress"
    },
    "tasks_total": {
      "type": "number",
      "default": 0
    },
    "tasks_completed": {
      "type": "number",
      "default": 0
    },
    "score": {
      "type": "number",
      "default": 0
    },
    "xp_earned": {
      "type": "number",
      "default": 0
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_activity_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "student_id",
    "scenario_id",
    "school_id"
  ]
}