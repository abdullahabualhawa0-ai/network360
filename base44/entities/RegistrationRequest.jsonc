{
  "name": "RegistrationRequest",
  "type": "object",
  "properties": {
    "request_type": {
      "type": "string",
      "enum": [
        "individual",
        "school"
      ],
      "description": "\u0646\u0648\u0639 \u0627\u0644\u0637\u0644\u0628 \u2014 \u0641\u0631\u062f\u064a \u0623\u0648 \u0645\u062f\u0631\u0633\u064a"
    },
    "full_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0635\u0627\u062d\u0628 \u0627\u0644\u0637\u0644\u0628"
    },
    "email": {
      "type": "string",
      "description": "\u0628\u0631\u064a\u062f \u0635\u0627\u062d\u0628 \u0627\u0644\u0637\u0644\u0628"
    },
    "phone": {
      "type": "string",
      "description": "\u0631\u0642\u0645 \u0647\u0627\u062a\u0641 \u0635\u0627\u062d\u0628 \u0627\u0644\u0637\u0644\u0628"
    },
    "country": {
      "type": "string",
      "description": "\u0627\u0644\u062f\u0648\u0644\u0629 / \u0627\u0644\u0628\u0644\u062f"
    },
    "school_name": {
      "type": "string",
      "description": "\u0627\u0633\u0645 \u0627\u0644\u0645\u062f\u0631\u0633\u0629 \u2014 \u0644\u0644\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0645\u062f\u0631\u0633\u064a\u0629 \u0641\u0642\u0637"
    },
    "expected_students": {
      "type": "number",
      "description": "\u0639\u062f\u062f \u0627\u0644\u0637\u0644\u0627\u0628 \u0627\u0644\u0645\u062a\u0648\u0642\u0639 \u2014 \u0644\u0644\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0645\u062f\u0631\u0633\u064a\u0629"
    },
    "expected_teachers": {
      "type": "number",
      "description": "\u0639\u062f\u062f \u0627\u0644\u0623\u0633\u0627\u062a\u0630\u0629 \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u064a\u0646 \u2014 \u0644\u0644\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0645\u062f\u0631\u0633\u064a\u0629 (\u064a\u0635\u0628\u062d \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0644\u0623\u0633\u0627\u062a\u0630\u0629 \u0628\u0639\u062f \u0627\u0644\u062a\u0641\u0639\u064a\u0644)"
    },
    "expected_users": {
      "type": "number",
      "description": "\u0639\u062f\u062f \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u0645\u062a\u0648\u0642\u0639 \u2014 \u0644\u0644\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0641\u0631\u062f\u064a\u0629"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "in_progress",
        "accepted",
        "rejected"
      ],
      "default": "new",
      "description": "\u062d\u0627\u0644\u0629 \u0627\u0644\u0637\u0644\u0628 \u2014 \u062c\u062f\u064a\u062f\u060c \u062a\u0645 \u0627\u0644\u062a\u0648\u0627\u0635\u0644\u060c \u0642\u064a\u062f \u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629\u060c \u0645\u0642\u0628\u0648\u0644\u060c \u0645\u0631\u0641\u0648\u0636"
    },
    "notes": {
      "type": "string",
      "description": "\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u062f\u0627\u062e\u0644\u064a\u0629 \u0644\u0644\u0645\u0627\u0644\u0643"
    }
  },
  "required": [
    "request_type",
    "full_name",
    "email",
    "phone"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}