{
  "name": "ExamAccessRequest",
  "type": "object",
  "properties": {
    "student_id": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "student_email": {
      "type": "string"
    },
    "school_id": {
      "type": "string"
    },
    "exam_id": {
      "type": "string"
    },
    "exam_title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "reviewed_by": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "student_id",
    "exam_id",
    "school_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "school_admin"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}"
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.student_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "school_admin"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "school_admin"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "school_admin"
              }
            },
            {
              "data.school_id": "{{user.data.school_id}}"
            }
          ]
        }
      ]
    }
  }
}